<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iPhone & Watch sync: the private iCloud database. `make app` fills in the team and environment
	     from the provisioning profile, which must grant every key here (Scripts/check-entitlements.sh). -->
	<key>com.apple.application-identifier</key><string>@TEAM_ID@.com.scalexy.headroom</string>
	<key>com.apple.developer.team-identifier</key><string>@TEAM_ID@</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.scalexy.headroom</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Developer ID builds can only reach the Production environment. -->
	<key>com.apple.developer.icloud-container-environment</key><string>@CLOUDKIT_ENV@</string>
	<!-- Silent pushes tell the store when another device changed something. -->
	<key>com.apple.developer.aps-environment</key><string>@APS_ENV@</string>
</dict>
</plist>
